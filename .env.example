# No Square keys in this file. Ever.
BAKERY_DB=data/app.db
HOST=127.0.0.1
PORT=8000

# Shop laptop only. Copy to .env and fill in. Never commit .env.
# SQUARE_LOCATION_ID defaults to Irondale L4CK6YWGT5XQX when left empty.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# laptop (default) | drinks | desk
BAKERY_SERVICE=laptop
# Cloud Scheduler header X-Ingest-Key. Glenn wires Secret Manager. Never commit.
INGEST_KEY=
