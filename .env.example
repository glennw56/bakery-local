# No Square keys in this file. Ever.
BAKERY_DB=data/app.db
HOST=127.0.0.1
PORT=8000

# Shop laptop only. Copy to .env and fill in. Never commit .env.
# SQUARE_LOCATION_ID defaults to Irondale L4CK6YWGT5XQX when left empty.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# QR order beta (Irondale only). Prefer this over SQUARE_LOCATION_ID when set.
SQUARE_LOCATION_ID_IRONDALE=
# Seconds to cache Square Catalog on /order. Default 90. 0 = no cache.
# CATALOG_CACHE_SECONDS=90
# Public origin of bakery-drinks Cloud Run, no trailing slash. Square redirect after pay.
ORDER_PUBLIC_URL=

# Ready-text SMS (Twilio). All three required or /order will not offer a phone / promise a text.
# Billed to Twilio, not GCP. Never commit real values.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=


# laptop (default) | drinks | desk
BAKERY_SERVICE=laptop
# Cloud Scheduler header X-Ingest-Key. Glenn wires Secret Manager. Never commit.
INGEST_KEY=

# Public drinks only. Laptop Square ingest is used when this is empty.
GETORDERS_URL=

# Desk Cloud Run only. Laptop sqlite is used when this is empty.
GETREPORTS_URL=

# Desk Cloud Run. Laptop leave empty (unlocked sqlite UI). Glenn wires Secret Manager.
# Never commit a real password.
ADMIN_PASSWORD=
